# Copy to tunnel.env and fill in. This file is read by tunnel-keep.sh.
# ---- landing side (the machine you will connect FROM: your PC/Mac or a jump host)
JUMP_USER=youruser
JUMP_HOST=jump.example.com
# Key the AGENT uses to log into the landing machine (agent side private key).
JUMP_KEY=~/.ssh/id_ed25519
# Optional ProxyCommand for reaching the landing machine, e.g. via a
# Tailscale CONNECT proxy. Leave empty for a directly reachable jump host.
PROXY_COMMAND=
# ---- the door
# Port on the LANDING machine (bound to its localhost) that leads back in.
REMOTE_PORT=2222
# Port of the SSH service inside the agent machine (localhost).
LOCAL_PORT=2223
